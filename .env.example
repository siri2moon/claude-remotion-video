# Giọng đọc ElevenLabs cho skill siri2moon-short. Chỉ dùng khi short.json có khối "narration".
# Chép file này thành .env rồi điền vào. .env không được đưa lên git.
ELEVENLABS_API_KEY=
# Voice ID mặc định theo ngôn ngữ (lấy ở elevenlabs.io → Voices → nút copy ID).
# short.json → narration.voice.{vi,en} đè lên hai dòng này.
ELEVENLABS_VOICE_VI=
ELEVENLABS_VOICE_EN=
# Model: eleven_v3 (mặc định, đọc được tiếng Việt, hiểu tag cảm xúc như [excited]) hoặc eleven_flash_v2_5 (rẻ, nhanh).
ELEVENLABS_MODEL=eleven_v3
